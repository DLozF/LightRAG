# Server

HOST=127.0.0.1
PORT=9621


# LLM (Ollama)

LLM_BINDING=ollama
LLM_BINDING_HOST=http://ollama:11434
LLM_MODEL=gemma4:12b

# disable reasoning during LightRAG Ollama LLM calls
OLLAMA_LLM_THINK=false

# updated to support mineru for ocr
LIGHTRAG_PARSER=*:native-iteP,*:mineru-iteP,*:legacy-R

# # switch for multimodal processing
VLM_PROCESS_ENABLE=true
VLM_LLM_BINDING=ollama
VLM_LLM_BINDING_HOST=http://ollama:11434
VLM_LLM_MODEL=gemma4:12b
VLM_MAX_ASYNC_LLM=1
VLM_LLM_TIMEOUT=600

MINERU_API_MODE=local
MINERU_LOCAL_ENDPOINT=http://mineru-api:8000
MINERU_LOCAL_BACKEND=pipeline
MINERU_LOCAL_PARSE_METHOD=auto
# false because we want lightrag to extract the images, but not have mineru's vlm analyze them
MINERU_LOCAL_IMAGE_ANALYSIS=false
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true

OLLAMA_LLM_NUM_CTX=100000
MAX_ASYNC_LLM=1
LLM_TIMEOUT=900

OLLAMA_LLM_NUM_PREDICT=64000

# Embeddings (Ollama)


EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://ollama:11434
EMBEDDING_MODEL=qwen3-embedding:8b

OLLAMA_EMBEDDING_NUM_CTX=8192
EMBEDDING_TOKEN_LIMIT=4096

# Verify with:
# ollama show qwen3-embedding:8b
EMBEDDING_DIM=4096
EMBEDDING_TIMEOUT=600


# Query / Extraction


ENTITY_EXTRACTION_USE_JSON=true
ENABLE_LLM_CACHE=true
SUMMARY_LANGUAGE=English

MAX_PARALLEL_INSERT=3
EMBEDDING_FUNC_MAX_ASYNC=1

# Chunking


CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100

# Reranking

RERANK_BINDING=null

# Storage Backends

LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
#depends on lightrg release
LIGHTRAG_VECTOR_STORAGE=QdrantVectorDBStorage
# LIGHTRAG_VECTOR_STORAGE=QdrantStorage

# PostgreSQL

POSTGRES_HOST=localhost
POSTGRES_PORT=5432

POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DATABASE=rag

POSTGRES_MAX_CONNECTIONS=12

POSTGRES_VECTOR_INDEX_TYPE=HNSW
POSTGRES_HNSW_M=16
POSTGRES_HNSW_EF=200

# Neo4j

NEO4J_URI=neo4j://localhost:7687

NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=Daniel2026

NEO4J_DATABASE=neo4j

# Qdrant

QDRANT_URL=http://localhost:6333



# LIGHTRAG_API_KEY=your_api_key_here
